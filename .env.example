APP_NAME=keyhome
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Production: LOG_CHANNEL=production (daily + stderr for Docker)
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=testing
DB_USERNAME=gitlab
DB_PASSWORD=test_pass

SESSION_DRIVER=cookie
# Production: use redis for lower latency and to avoid DB contention (G-7)
# SESSION_DRIVER=redis — use REDIS_URL=rediss://... for TLS when Redis is remote
# PWA requires long-lived sessions — 43200 = 30 days. Clerk users are unaffected
# (Clerk manages its own session). Email/password users stay logged in for 30 days.
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
# SameSite: 'lax' when frontend and backend share the same registrable domain (e.g.
# keyhome.app + api.keyhome.app). Use 'none' when on different domains (cross-origin).
# 'none' REQUIRES SESSION_SECURE_COOKIE=true and HTTPS.
SESSION_SAME_SITE=lax
SESSION_PATH=/
# SESSION_DOMAIN must match your APP_URL domain (e.g. keyhome.test locally, your-domain.com in prod)
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production: FILESYSTEM_DISK=r2 stores all media on R2. APP_MEDIA_DISK overrides for logos/avatars/contracts.
# R2 structure: avatars/, agency-logos/, lease-contracts/, ads/ (Spatie), tours/
# TOUR_STORAGE_DISK=r2
QUEUE_CONNECTION=sync
# Production: use redis for ~20x faster job pickup vs database polling
# QUEUE_CONNECTION=redis

CACHE_STORE=array
# Production: use redis for ~40x lower cache latency vs database
# CACHE_STORE=redis

# Redis - use TLS (rediss://) in production or ensure Docker-internal only
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=log
# Production SMTP settings (uncomment and fill for real email delivery):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=no-reply@keyhome.app
# MAIL_FROM_NAME="${APP_NAME}"

SCOUT_DRIVER=null

MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# OAuth Configuration (Laravel Socialite)
# Google - https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/google/callback

# Facebook - https://developers.facebook.com/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/facebook/callback

# Apple - https://developer.apple.com/
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/apple/callback

# AI — LLM providers
# AI_SEARCH_PROVIDERS: ordered comma-separated list for natural language search failover.
# First provider with a valid key and open circuit is used. Others are tried automatically.
# Supported: groq, openai, gemini, together, mistral
AI_SEARCH_PROVIDERS=groq,openai,gemini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# AI_PROVIDER=groq pour AiDescriptionEnhancer (openai|groq|gemini)
AI_PROVIDER=groq
OPENAI_API_KEY=

# Seeding: SEED_FAST_MODE=true = 200 ads, 2-3 images (~10x faster). false = 2000 ads, 5-7 images.
SEED_FAST_MODE=true

# Clerk - https://dashboard.clerk.com/
# The publishable key is used to derive the JWKS URL automatically.
# Set CLERK_JWKS_URL explicitly if you change Clerk instances/domains.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=
# CLERK_JWKS_URL example: https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_...

EMAIL_VERIFY_CALLBACK=http://localhost
EMAIL_CALLBACK_URL=http://localhost
# Public URL of the Next.js frontend — used in all email CTAs and links.
# Change to your production domain in staging/prod (e.g. https://app.keyhome.neocraft.dev)
FRONTEND_URL=http://localhost:3000

# Comma-separated additional OAuth redirect hosts (frontend_url host is always allowed)
OAUTH_ALLOWED_REDIRECT_HOSTS=

# Admin API MFA session lifetime in minutes (default 8 hours)
MFA_API_SESSION_LIFETIME=480
MAIL_ASSET_BASE_URL=https://keyhome.app

L5_SWAGGER_GENERATE_ALWAYS=false
SANCTUM_STATEFUL_DOMAINS=localhost
SANCTUM_TOKEN_PREFIX=kh_

# Comma-separated list of trusted proxy IPs or CIDR ranges (e.g. 172.18.0.0/16 for Docker)
# Set to * only if behind a single fully trusted reverse proxy (not recommended in production)
TRUSTED_PROXIES=127.0.0.1

# CORS origins for tour-image and media-proxy endpoints (comma-separated)
# Default: uses config(cors.allowed_origins). Use * for wildcard (not recommended in production)
# PROXY_CORS_ORIGINS=

TELESCOPE_ENABLED=false

# PostgreSQL SSL: prefer for dev; prefer for Docker (DB on same network, no SSL).
# Use require only when DB is external (e.g. managed RDS) and supports TLS.
DB_SSLMODE=prefer

# Backup (spatie/laravel-backup): DB + files daily at 02:00
# BACKUP_DISKS=local
# Production: BACKUP_DISKS=local,backups for offsite storage (requires backups disk config)
# BACKUP_NOTIFICATION_MAIL=admin@example.com
# Send backup zip by email (attachment skipped if > BACKUP_MAIL_MAX_SIZE_MB, default 20MB)
# BACKUP_SEND_BY_MAIL=true
# BACKUP_MAIL_MAX_SIZE_MB=20

# Neighborhood scorecard (OpenStreetMap Overpass) — optional overrides
# NEIGHBORHOOD_SCORECARD_OVERPASS_URL=https://overpass-api.de/api/interpreter
# NEIGHBORHOOD_SCORECARD_CACHE_TTL=604800
# NEIGHBORHOOD_SCORECARD_CACHE_TTL_DEGRADED=300
# NEIGHBORHOOD_SCORECARD_HTTP_TIMEOUT=15
# NEIGHBORHOOD_SCORECARD_HTTP_RETRY_TIMES=2
# NEIGHBORHOOD_SCORECARD_HTTP_RETRY_DELAY_MS=1500
# OpenRouteService API key — enables isochrones, directions, and walking distances in scorecards
# https://openrouteservice.org/dev/#/home  →  free tier: 2 000 req/day
ORS_API_KEY=

# Mapbox GL JS — used for the admin geographic heatmap map
# https://account.mapbox.com/ → Create a token (public pk.xxx)
MAPBOX_TOKEN=

# Optional overrides for the neighborhood scorecard ORS matrix call
# (the key above is shared; these only change URL and timeout)
# NEIGHBORHOOD_SCORECARD_ORS_MATRIX_URL=https://api.openrouteservice.org/v2/matrix/foot-walking
# NEIGHBORHOOD_SCORECARD_ORS_TIMEOUT=12

# ─── WebSocket (Reverb) ─────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=keyhome_chat
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https

# ─── Chat Encryption ────────────────────────────────────────────────
# Generate: php -r "echo bin2hex(random_bytes(32));"
CHAT_ENCRYPTION_KEY=

# ─── Firebase FCM ───────────────────────────────────────────────────
FIREBASE_CREDENTIALS=storage/app/firebase-credentials.json

# ─── Frontend Reverb ────────────────────────────────────────────────
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=your-api-domain.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# ─── Frontend Firebase ──────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
