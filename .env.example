APP_NAME=keyhome
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Africa/Douala
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Production: LOG_CHANNEL=production (daily + stderr for Docker)
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=testing
DB_USERNAME=gitlab
DB_PASSWORD=test_pass

SESSION_DRIVER=cookie
# Production: use redis for lower latency and to avoid DB contention (G-7)
# SESSION_DRIVER=redis — use REDIS_URL=rediss://... for TLS when Redis is remote
# PWA requires long-lived sessions — 43200 = 30 days. Clerk users are unaffected
# (Clerk manages its own session). Email/password users stay logged in for 30 days.
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
# SameSite: 'lax' when frontend and backend share the same registrable domain (e.g.
# keyhome.app + api.keyhome.app). Use 'none' when on different domains (cross-origin).
# 'none' REQUIRES SESSION_SECURE_COOKIE=true and HTTPS.
SESSION_SAME_SITE=lax
SESSION_PATH=/
# SESSION_DOMAIN: use '.keyhome.app' (leading dot) in production so the cookie is shared
# between api.keyhome.app (backend) and keyhome.app (frontend). Null = host-only cookie.
# Production: SESSION_DOMAIN=.keyhome.app
SESSION_DOMAIN=null

# SANCTUM_STATEFUL_DOMAINS: comma-separated FRONTEND domains that receive stateful session auth.
# ⚠️  CRITICAL: if keyhome.app is missing, Laravel treats all requests from the frontend
# as stateless API (no session) → /auth/me returns 401 after login for email/password users.
# Production: SANCTUM_STATEFUL_DOMAINS=keyhome.app,www.keyhome.app,owner.keyhome.app
# Dev:        leave unset (defaults to localhost variants + APP_URL)
# SANCTUM_STATEFUL_DOMAINS=keyhome.app,www.keyhome.app,owner.keyhome.app

BROADCAST_CONNECTION=reverb

# ─── WebSocket (Reverb) ─────────────────────────────────────────────
# Two distinct address pairs:
#   REVERB_HOST / REVERB_PORT / REVERB_SCHEME
#       Public WSS endpoint. Used by:
#         - Pusher SDK on the frontend (matches NEXT_PUBLIC_REVERB_*)
#         - Broadcaster auth signatures inside Laravel
#       In production this is the Traefik-fronted hostname (e.g. reverb.keyhome.app)
#       on port 443 over https. Locally use 127.0.0.1:8080 / http.
#
#   REVERB_SERVER_HOST / REVERB_SERVER_PORT
#       Internal listen socket of the `php artisan reverb:start` daemon.
#       Always 0.0.0.0:8080 inside the container; Traefik forwards to it.
#
#   REVERB_BROADCAST_HOST / REVERB_BROADCAST_PORT / REVERB_BROADCAST_SCHEME (optional)
#       Outbound HTTP from PHP (app + queue workers) to the Reverb Pusher API.
#       Defaults fall back to REVERB_HOST / REVERB_PORT / REVERB_SCHEME.
#       In Docker, the public Traefik hostname often does not resolve inside the
#       bridge network — docker-compose.yml / docker-compose.preprod.yml set these
#       to reverb:8080 / http for app and worker.
#
# Generate keys (one-time, REVERB_APP_KEY must equal NEXT_PUBLIC_REVERB_APP_KEY):
#   php -r "echo bin2hex(random_bytes(16));" → REVERB_APP_KEY
#   php -r "echo bin2hex(random_bytes(32));" → REVERB_APP_SECRET
REVERB_APP_ID=keyhome_chat
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Local dev: 127.0.0.1 + 8080 + http. Production: public hostname + 443 + https.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Traefik routing for the reverb service (docker-compose.yml). Production only.
REVERB_DOMAIN=reverb.keyhome.app

# ─── Chat E2EE ──────────────────────────────────────────────────────
# Activates client-sealed (E2EE) messages. Each device owns an RSA-OAEP keypair;
# per-conversation AES key wrapped with participant public keys. Set false to use
# server-side AES encryption only (Telegram/WhatsApp Web model — easier new-device access).
CHAT_CLIENT_SEALED_ENABLED=true

# ─── Frontend Reverb ────────────────────────────────────────────────
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=your-api-domain.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# ─── Cloudflare Turnstile (CAPTCHA on /login + /register) ───────────
# Production / staging: set both keys from Cloudflare → Turnstile. Add every
# frontend hostname under Widget → Hostname Management (error 110200 = domain not allowed).
# @see https://developers.cloudflare.com/turnstile/additional-configuration/hostname-management/
#
# Local (APP_ENV=local): Laravel uses Cloudflare dummy keys by default (even if the two
# lines below are filled) so http://localhost:* works without Turnstile hostname setup (110200).
# To test real keys on local: TURNSTILE_USE_PRODUCTION_KEYS=true (+ hostnames in Cloudflare).
# @see https://developers.cloudflare.com/turnstile/troubleshooting/testing/
#
# Next.js (optional): NEXT_PUBLIC_TURNSTILE_USE_PRODUCTION_KEYS=true if you use real keys on localhost
#
# Non-local: when TURNSTILE_SECRET_KEY is empty, verification is skipped (fail-open).
# TURNSTILE_SITE_KEY can be exposed to the frontend via NEXT_PUBLIC_* or GET /api/v1/config/turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Firebase FCM ───────────────────────────────────────────────────
FIREBASE_CREDENTIALS=storage/app/firebase-credentials.json

# ─── Frontend Firebase (FCM web push) ─────────────────────────────
# Fire HTTP 401 on fcmregistrations.googleapis.com if VAPID is wrong or API key blocks the origin.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push **public** key from Firebase Console → Project settings → Cloud Messaging → Web push certificates (NOT NEXT_PUBLIC_VAPID_PUBLIC_KEY).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Next.js / Vercel — Microsoft Clarity session analytics (optional).
# Project ID from https://clarity.microsoft.com/ → Setup → install manually. Leave empty to disable.
# CSP allowlist: `src/lib/csp-allowlist.ts` (https://*.clarity.ms, https://c.bing.com connect-src).
NEXT_PUBLIC_MICROSOFT_CLARITY_PROJECT_ID=
# If the Browser key is restricted in Google Cloud, add referrers: http://localhost:3000/* https://*.keyhome.app/* https://*.neocraft.dev/*
FILESYSTEM_DISK=local
# Production: FILESYSTEM_DISK=r2 stores all media on R2. APP_MEDIA_DISK overrides for logos/avatars/contracts.
# R2 structure: avatars/, agency-logos/, lease-contracts/, ads/ (Spatie), tours/
# TOUR_STORAGE_DISK=r2
QUEUE_CONNECTION=sync
# Production: use redis for ~20x faster job pickup vs database polling
# QUEUE_CONNECTION=redis

CACHE_STORE=array
# Production: use redis for ~40x lower cache latency vs database
# CACHE_STORE=redis

# Redis - use TLS (rediss://) in production or ensure Docker-internal only
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── Mail (Resend) ──────────────────────────────────────────────────
# Get your API key at https://resend.com → API Keys
# Verify domain keyhome.app: Resend → Domains → Add domain (adds DKIM + SPF records)
MAIL_MAILER=resend
RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxx
# E-2 : Webhook signing secret (Resend Dashboard → Webhooks → Signing secret)
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default FROM (transactional / noreply)
MAIL_FROM_ADDRESS=noreply@keyhome.app
MAIL_FROM_NAME="KeyHome"

# Named senders — used by HasSender trait in Mailable classes
# noreply : transactionnel pur (OTP, reçus, sécurité)
MAIL_NOREPLY_ADDRESS=noreply@keyhome.app
MAIL_NOREPLY_NAME="KeyHome"
# notifications : alertes système (annonces, rappels, abonnements)
MAIL_NOTIFICATIONS_ADDRESS=notifications@keyhome.app
MAIL_NOTIFICATIONS_NAME="KeyHome Notifications"
# marketing : newsletters, campagnes, promotions
MAIL_MARKETING_ADDRESS=marketing@keyhome.app
MAIL_MARKETING_NAME="KeyHome"
# support : service client, formulaire contact, signalements
MAIL_SUPPORT_ADDRESS=support@keyhome.app
MAIL_SUPPORT_NAME="KeyHome Support"
# bailleurs : onboarding bailleurs & agences immobilières
MAIL_BAILLEURS_ADDRESS=bailleurs@keyhome.app
MAIL_BAILLEURS_NAME="KeyHome Bailleurs"
# admin : notifications internes équipe, modération
MAIL_ADMIN_ADDRESS=admin@keyhome.app
MAIL_ADMIN_NAME="KeyHome Admin"
# facturation : factures, reçus d'achat, remboursements, relances paiement
MAIL_FACTURATION_ADDRESS=facturation@keyhome.app
MAIL_FACTURATION_NAME="KeyHome Facturation"

# ─── Boîtes humaines Zoho Mail ──────────────────────────────────────
# Ces adresses sont des boîtes ou alias Zoho. Laravel ne les utilise
# pas comme expéditeur (FROM) — elles reçoivent et répondent aux emails.
# Créer comme alias dans Zoho Mail → redirigent vers support@ ou fondateur.
#
# 🔴 Priorité IMMÉDIATE (avant tout envoi prod)
#   hello@keyhome.app         → Premier contact, partenariats, presse  (alias → support@)
#   bailleurs@keyhome.app     → Onboarding bailleurs, questions KYC    (alias → support@)
#   security@keyhome.app      → Bug bounty, failles de sécurité        (alias → fondateur)
#   abuse@keyhome.app         → Signalement contenu frauduleux         (OBLIGATOIRE légalement)
#
# 🟡 Avant le lancement officiel
#   contact@keyhome.app       → Formulaire contact général             (alias → support@)
#   facturation@keyhome.app   → Questions paiements (réponses humaines)(alias → support@)
#   legal@keyhome.app         → Litiges, RGPD, injonctions judiciaires (alias → fondateur)
#   partenaires@keyhome.app   → B2B, agences, intégrateurs             (alias → support@)
#
# 🟢 Après le lancement
#   presse@keyhome.app        → Journalistes, interviews               (alias → fondateur)
#   ambassadeurs@keyhome.app  → Influenceurs, programme référence      (alias → marketing@)
#   recrutement@keyhome.app   → CVs, stages, freelances                (alias → fondateur)
#   admin@keyhome.app         → Alertes Cloudflare/GitLab/Sentry       (alias → fondateur)
#   tech@keyhome.app          → Intégrations techniques, webhooks      (alias → dev interne)
#   comptabilite@keyhome.app  → Fiscalité, banques (jamais public)     (alias → fondateur)

# Local dev: use 'log' to write emails to storage/logs/laravel.log instead of sending
# MAIL_MAILER=log

SCOUT_DRIVER=null
# Production: enable queue indexing + after-commit dispatch to avoid:
#   1. Synchronous Meilisearch HTTP calls inside web requests (latency)
#   2. Silent desync when DB transactions roll back after indexing
# Without these, the index can drift from the DB (e.g. 3 docs in Meilisearch
# vs 165 in the ad table) and `/api/v1/ads/search` returns 0 results.
SCOUT_QUEUE=true
SCOUT_AFTER_COMMIT=true

MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# OAuth Configuration (Laravel Socialite)
# Google - https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/google/callback

# Facebook - https://developers.facebook.com/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/facebook/callback

# Apple - https://developer.apple.com/
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/apple/callback

# GitHub - https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/github/callback

# Schemes deep-link autorisés pour le retour OAuth vers les apps mobiles
# (Expo/standalone). Doit contenir les scheme des deux apps.
OAUTH_ALLOWED_REDIRECT_SCHEMES=keyhome,keyhomeowners

# AI — LLM providers
# AI_SEARCH_PROVIDERS: ordered comma-separated list for natural language search failover.
# First provider with a valid key and open circuit is used. Others are tried automatically.
# Supported: groq, openai, gemini, together, mistral
AI_SEARCH_PROVIDERS=groq,openai,gemini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
COHERE_API_KEY=
# gemini-2.0-flash retires 2026-06-01 — default flipped to gemini-2.5-flash-lite
# (same $0.10/$0.40 per 1M price point, GA stable, drop-in replacement).
GEMINI_MODEL=gemini-2.5-flash-lite

TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# AI search rate limits (per IP for guests, per user when authenticated).
# `minute` and `day` are AND-ed at the route layer via stacked throttle:* middlewares.
# `hourly_global` is a soft cost ceiling shared by all callers — once hit the route
# returns 429 across the cluster (OWASP LLM10:2025 — Unbounded Consumption).
RL_AI_SEARCH_PARSE_MINUTE=30
RL_AI_SEARCH_PARSE_DAY=200
RL_AI_SEARCH_PARSE_HOURLY_GLOBAL=10000

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# AI_PROVIDER=groq pour AiDescriptionEnhancer (openai|groq|gemini)
AI_PROVIDER=groq
OPENAI_API_KEY=

# Seeding: SEED_FAST_MODE=true = 200 ads, 2-3 images (~10x faster). false = 2000 ads, 5-7 images.
SEED_FAST_MODE=true

# Clerk - https://dashboard.clerk.com/
# The publishable key is used to derive the JWKS URL automatically.
# Set CLERK_JWKS_URL explicitly if you change Clerk instances/domains.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=
# CLERK_JWKS_URL example: https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_...

EMAIL_VERIFY_CALLBACK=http://localhost
EMAIL_CALLBACK_URL=http://localhost
# Public URL of the Next.js frontend — used in all email CTAs and links.
# Change to your production domain in staging/prod (e.g. https://app.keyhome.neocraft.dev)
FRONTEND_URL=http://localhost:3000

# Comma-separated additional OAuth redirect hosts (frontend_url host is always allowed)
OAUTH_ALLOWED_REDIRECT_HOSTS=

# Admin API MFA session lifetime in minutes (default 8 hours)
MFA_API_SESSION_LIFETIME=480
MAIL_ASSET_BASE_URL=https://keyhome.app

# Physical mailing address shown in email footers (CAN-SPAM / RGPD compliance).
MAIL_COMPANY_ADDRESS="KeyHome · Douala, Cameroun"

L5_SWAGGER_GENERATE_ALWAYS=false
SANCTUM_STATEFUL_DOMAINS=localhost
SANCTUM_TOKEN_PREFIX=kh_

# Comma-separated list of trusted proxy IPs or CIDR ranges (e.g. 172.18.0.0/16 for Docker)
# Set to * only if behind a single fully trusted reverse proxy (not recommended in production)
TRUSTED_PROXIES=127.0.0.1

# CORS origins for tour-image and media-proxy endpoints (comma-separated)
# Default: uses config(cors.allowed_origins). Use * for wildcard (not recommended in production)
# PROXY_CORS_ORIGINS=

TELESCOPE_ENABLED=false
# Comma-separated list of admin e-mails allowed to view Telescope in non-local
# environments. Leave empty to block all access (fail-closed). The gate also
# requires the user to have `isAdmin()` true — defense in depth.
# Example: TELESCOPE_ALLOWED_EMAILS=ops@keyhome.app,cto@keyhome.app
TELESCOPE_ALLOWED_EMAILS=

# PostgreSQL SSL: prefer for dev; prefer for Docker (DB on same network, no SSL).
# Use require only when DB is external (e.g. managed RDS) and supports TLS.
DB_SSLMODE=prefer

# ─── Backup base de données (spatie/laravel-backup) ─────────────────────────
# backup:run s'exécute chaque nuit à 02h00 UTC depuis le conteneur `app`.
# Le dump est uploadé sur Cloudflare R2. Un email avec un lien signé (valide 48h)
# est envoyé automatiquement à BACKUP_NOTIFICATION_MAIL.
#
# Production (activer R2) :
BACKUP_DISKS=backups
BACKUP_NOTIFICATION_MAIL=admin@keyhome.app
#
# Cloudflare R2 — créer un bucket "keyhome-db-backups" et un token R2
# (Permissions : Object Read & Write, scope au bucket)
# Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create Token
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=keyhome-db-backups
# Remplace {ACCOUNT_ID} par ton Cloudflare Account ID (visible dans le dashboard R2)
BACKUP_R2_ENDPOINT=https://{ACCOUNT_ID}.r2.cloudflarestorage.com
#
# Archive password (optionnel — chiffre le zip avant upload)
# BACKUP_ARCHIVE_PASSWORD=

# Neighborhood scorecard (OpenStreetMap Overpass) — optional overrides
# NEIGHBORHOOD_SCORECARD_OVERPASS_URL=https://overpass-api.de/api/interpreter
# NEIGHBORHOOD_SCORECARD_CACHE_TTL=604800
# NEIGHBORHOOD_SCORECARD_CACHE_TTL_DEGRADED=300
# NEIGHBORHOOD_SCORECARD_HTTP_TIMEOUT=15
# NEIGHBORHOOD_SCORECARD_HTTP_RETRY_TIMES=2
# NEIGHBORHOOD_SCORECARD_HTTP_RETRY_DELAY_MS=1500
# OpenRouteService API key — enables isochrones, directions, and walking distances in scorecards
# https://openrouteservice.org/dev/#/home  →  free tier: 2 000 req/day
ORS_API_KEY=
# Self-hosted ORS only: send API key without "Bearer " prefix (cloud API uses Bearer automatically).
# ORS_AUTHORIZATION_RAW=false

# Mapbox GL JS — used for the admin geographic heatmap map.
# https://account.mapbox.com/ → Create a token (public pk.xxx).
#
# SECURITY: this token ships to the browser bundle (it's a `pk.*`
# public token by design). To stop a leaked token from being used
# off-site, restrict it on the Mapbox dashboard to the production
# referrers — for KeyHome that's:
#   - https://app.keyhome.app/*
#   - https://preprod.keyhome.app/*
#   - http://localhost:3000/* (dev only — drop before rotating)
# Dashboard → Access tokens → edit the token → URL restrictions.
MAPBOX_TOKEN=

# Optional overrides for the neighborhood scorecard ORS matrix call
# (the key above is shared; these only change URL and timeout)
# NEIGHBORHOOD_SCORECARD_ORS_MATRIX_URL=https://api.openrouteservice.org/v2/matrix/foot-walking
# NEIGHBORHOOD_SCORECARD_ORS_TIMEOUT=12

# ============================================================
# GeniusPay (Mobile Money / Orange — gateway = "geniuspay")
# ============================================================
# Clés marchand : https://pay.genius.ci/dashboard/settings?tab=api
# Sandbox : pk_sandbox_* / sk_sandbox_* / whsec_sandbox_*
# Production : pk_live_* / sk_live_* / whsec_live_*
GENIUSPAY_API_KEY=pk_sandbox_replace_with_public_key
GENIUSPAY_API_SECRET=sk_sandbox_replace_with_secret_key
GENIUSPAY_WEBHOOK_SECRET=whsec_replace_with_webhook_signing_secret
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
# Optional return URL override (otherwise /payment/return on FRONTEND_URL)
# GENIUSPAY_REDIRECT_URL=https://keyhome.app/payment/return?flow=credit
GENIUSPAY_DEFAULT_COUNTRY=CM
PAYMENT_DEFAULT_GATEWAY=geniuspay

# ============================================================
# Stripe (carte bancaire — gateway = "stripe")
# ============================================================
# Account API keys — find them at https://dashboard.stripe.com/apikeys
# In test mode: pk_test_* / sk_test_*. In live mode: pk_live_* / sk_live_*.
# A SINGLE webhook secret is used for both modes — rotate the value when
# switching environments.
STRIPE_KEY=pk_test_replace_with_publishable_key
STRIPE_SECRET=sk_test_replace_with_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_webhook_signing_secret

# Stripe billing currency. KeyHome stores XAF canonically and Stripe
# is invoiced in EUR using the BEAC peg (1 EUR = 655.957 XAF). Do NOT
# set to xaf/xof — Stripe rejects them.
STRIPE_CURRENCY=eur

# Webhook event tolerance in seconds (default 300). Tighten if you
# observe replay attempts beyond Stripe's published 5 min window.
STRIPE_WEBHOOK_TOLERANCE=300

# IndexNow — instant indexing for Bing/Yandex (generate key at bing.com/webmasters)
# Host the file {INDEXNOW_KEY}.txt in keyhome-frontend-next/public/ with the key as content
INDEXNOW_KEY=
INDEXNOW_HOST=keyhome.app
