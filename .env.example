APP_NAME=keyhome
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=testing
DB_USERNAME=gitlab
DB_PASSWORD=test_pass

SESSION_DRIVER=cookie
# Production: use redis for lower latency and to avoid DB contention (G-7)
# SESSION_DRIVER=redis — use REDIS_URL=rediss://... for TLS when Redis is remote
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production: FILESYSTEM_DISK=r2 stores all media on R2. APP_MEDIA_DISK overrides for logos/avatars/contracts.
# R2 structure: avatars/, agency-logos/, lease-contracts/, ads/ (Spatie), tours/
# TOUR_STORAGE_DISK=r2
QUEUE_CONNECTION=sync
# Production: use redis for ~20x faster job pickup vs database polling
# QUEUE_CONNECTION=redis

CACHE_STORE=array
# Production: use redis for ~40x lower cache latency vs database
# CACHE_STORE=redis

# Redis - use TLS (rediss://) in production or ensure Docker-internal only
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=log
# Production SMTP settings (uncomment and fill for real email delivery):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=no-reply@keyhome.app
# MAIL_FROM_NAME="${APP_NAME}"

SCOUT_DRIVER=null

MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# OAuth Configuration (Laravel Socialite)
# Google - https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/google/callback

# Facebook - https://developers.facebook.com/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/facebook/callback

# Apple - https://developer.apple.com/
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/apple/callback

# AI — Groq (recherche IA), OpenAI, Gemini (descriptions d'annonces)
# GROQ_API_KEY requis pour la recherche en langage naturel (Recherche IA)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# AI_PROVIDER=groq pour AiDescriptionEnhancer (openai|groq|gemini)
AI_PROVIDER=groq
OPENAI_API_KEY=
GEMINI_API_KEY=

# Seeding: SEED_FAST_MODE=true = 200 ads, 2-3 images (~10x faster). false = 2000 ads, 5-7 images.
SEED_FAST_MODE=true

# Clerk - https://dashboard.clerk.com/
# The publishable key is used to derive the JWKS URL automatically.
# Set CLERK_JWKS_URL explicitly if you change Clerk instances/domains.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=
# CLERK_JWKS_URL example: https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_...

EMAIL_VERIFY_CALLBACK=http://localhost
EMAIL_CALLBACK_URL=http://localhost
FRONTEND_URL=http://localhost:3000

L5_SWAGGER_GENERATE_ALWAYS=false
SANCTUM_STATEFUL_DOMAINS=localhost
SANCTUM_TOKEN_PREFIX=kh_

# Comma-separated list of trusted proxy IPs or CIDR ranges (e.g. 172.18.0.0/16 for Docker)
# Set to * only if behind a single fully trusted reverse proxy (not recommended in production)
TRUSTED_PROXIES=127.0.0.1

# CORS origins for tour-image and media-proxy endpoints (comma-separated)
# Default: uses config(cors.allowed_origins). Use * for wildcard (not recommended in production)
# PROXY_CORS_ORIGINS=

TELESCOPE_ENABLED=false

# PostgreSQL SSL: prefer for dev; prefer for Docker (DB on same network, no SSL).
# Use require only when DB is external (e.g. managed RDS) and supports TLS.
DB_SSLMODE=prefer

# Backup (spatie/laravel-backup): DB + files daily at 02:00
# BACKUP_DISKS=local
# Production: BACKUP_DISKS=local,backups for offsite storage (requires backups disk config)
# BACKUP_NOTIFICATION_MAIL=admin@example.com
# Send backup zip by email (attachment skipped if > BACKUP_MAIL_MAX_SIZE_MB, default 20MB)
# BACKUP_SEND_BY_MAIL=true
# BACKUP_MAIL_MAX_SIZE_MB=20
