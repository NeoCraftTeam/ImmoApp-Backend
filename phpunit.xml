        <env name="GENIUSPAY_WEBHOOK_SECRET" value="whsec_sandbox_test_secret_123"/>
        <env name="FLW_SECRET_KEY" value="FLWSECK_TEST-fake"/>
        <env name="FLW_WEBHOOK_SECRET" value="test_webhook_secret_123"/>
        <env name="TURNSTILE_SITE_KEY" value=""/>
        <env name="TURNSTILE_SECRET_KEY" value=""/>
        <env name="CHAT_ENCRYPTION_KEY" value="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"/>
    </php>
</phpunit>
