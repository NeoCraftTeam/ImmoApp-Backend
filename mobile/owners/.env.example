# =============================================================
# KeyHome Owner — variables d'environnement Expo
# =============================================================
# Copier ce fichier en .env (ignoré par git) et remplir les vars.

# ─── API ─────────────────────────────────────────────────────
# Base URL de l'API KeyHome (préfixe /api/v1 inclus).
# ⚠️ La prod n'est pas à jour avec preprod (fix Turnstile, liaison de
# comptes…) et sa base n'a pas les comptes de test → login impossible.
# On tape preprod jusqu'à la release preprod→main.
EXPO_PUBLIC_API_BASE_URL=https://api.keyhome.neocraft.dev/api/v1
# Pour tester contre un backend Laravel local : décommentez et adaptez.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ─── Monitoring (optionnel) ──────────────────────────────────
# DSN Sentry — laissez vide en Expo Go (no-op).
# En dev build / production : récupérez la valeur dans
# Settings → Projects → keyhome / mobile-owners → Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=

# ─── Realtime / Reverb (optionnel) ───────────────────────────
# Sans ces vars le chat reste fonctionnel en polling 4 s (fallback).
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_REVERB_HOST=
EXPO_PUBLIC_REVERB_PORT=
# https | http (défaut https)
EXPO_PUBLIC_REVERB_SCHEME=https
