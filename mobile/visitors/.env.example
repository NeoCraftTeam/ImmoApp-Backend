# Override the API base URL for local development (defaults to the
# `apiBaseUrlDev` value in app.json's `extra` block when not set).
# Most devs running the Laravel backend on a different host should set
# this to their machine's LAN IP so an iPhone simulator on the same
# Wi-Fi can reach the API.
#
# Example: EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=

# Mapbox public token (pk.*) — used by react-native-mapbox-gl on the
# ad-detail map. Restrict to the production app's bundle ids on the
# Mapbox dashboard, same as the web token.
EXPO_PUBLIC_MAPBOX_TOKEN=
