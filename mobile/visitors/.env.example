# API base URL pour cette app Expo.
#
# **Convention équipe** : on tape directement la **prod** même en dev —
# pas de Laravel local par défaut. Cf. README pour le rationale.
#
# Surcharge ponctuelle pour itérer sur le backend localement :
#   - iOS Simulator    → http://localhost:8000/api/v1
#   - Android emulator → http://10.0.2.2:8000/api/v1
#   - Device physique  → http://<IP-LAN-Mac>:8000/api/v1
#     (lancer `php artisan serve --host=0.0.0.0 --port=8000`)
EXPO_PUBLIC_API_BASE_URL=https://api.keyhome.app/api/v1

# Mapbox public token (pk.*) — used by react-native-mapbox-gl on the
# ad-detail map. Restrict to the production app's bundle ids on the
# Mapbox dashboard, same as the web token.
EXPO_PUBLIC_MAPBOX_TOKEN=
